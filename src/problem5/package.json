{
  "name": "problem5-ticket-api",
  "version": "1.0.0",
  "description": "Support Ticket Management API — Problem 5 (99Tech Code Challenge)",
  "private": true,
  "main": "dist/interface/http/server.js",
  "scripts": {
    "dev": "tsx watch src/interface/http/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/interface/http/docs && cp src/interface/http/docs/openapi.yaml dist/interface/http/docs/openapi.yaml",
    "start": "node dist/interface/http/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
