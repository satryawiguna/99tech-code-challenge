# Copy this file to .env for local development (npm run dev).
# Docker dev/prod environments should inject these variables directly
# (see docker-compose.yml) rather than relying on a committed .env file.

# local | dev | prod
NODE_ENV=local

# Port the HTTP server listens on
PORT=3000

# Filesystem path to the SQLite database file for this environment.
# Each environment (local/dev/prod) MUST use a distinct file/volume.
DATABASE_URL=./data/tickets.local.sqlite
