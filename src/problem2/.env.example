# Read client-side (usePriceFeedQuery runs in the browser) — Next.js only
# inlines NEXT_PUBLIC_* variables into the client bundle, so these are the
# ones that actually take effect at runtime.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_PRICE_FEED_URL=https://interview.switcheo.com/prices.json

# Unprefixed fallbacks, accepted by readAppConfig for any future
# server-only consumer. Setting only these (without the NEXT_PUBLIC_
# variants above) has no effect on the deployed app today.
APP_ENV=local
PRICE_FEED_URL=https://interview.switcheo.com/prices.json

# docker-compose.yml's app-dev/app-prod services set NEXT_PUBLIC_APP_ENV
# internally (as a Docker build arg) — this file's NEXT_PUBLIC_APP_ENV does
# not affect those two. Only NEXT_PUBLIC_PRICE_FEED_URL is meaningfully
# overridable for app-dev/app-prod, and only at build time (see README.md).
